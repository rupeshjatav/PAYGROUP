<*Function IScript_GetTandemUser()
   Local string &oprid;
   Local string &json;
   /* Get currently logged-in PeopleSoft operator */
   &oprid = %OperatorId;
   /* Return JSON */
   &json = "{""oprid"":""" | &oprid | """}";
   /* Set response type */
   %Response.SetContentType("application/json");
   /* Prevent browser caching */
   %Response.SetHeader("Cache-Control", "no-store");
   %Response.Write(&json);
